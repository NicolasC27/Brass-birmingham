# /etc/blackrail/office.env — the office's settings (root:blackrail, 640).
# Secrets live here and nowhere else: never in the repository.
PORT=8787
HOST=127.0.0.1
BLACKRAIL_DB=/srv/blackrail/data/brassworks.db
APP_URL=https://playblackrail.com
OFFICE_URL=https://office.playblackrail.com
BLACKRAIL_ORIGINS=https://playblackrail.com,https://www.playblackrail.com
TRUST_PROXY=1
# the direction: verified accounts with these addresses open /direction
BLACKRAIL_ADMINS=
# the post: without a key, the letters are printed in the office's journal
RESEND_API_KEY=
MAIL_FROM=Blackrail <bonjour@playblackrail.com>
MAIL_DAILY_CAP=80
