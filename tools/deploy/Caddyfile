# Blackrail on one machine: the site as files, the office behind a proxy.
# Caddy asks Let's Encrypt for every name here on its own.

playblackrail.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# the demo is framed by the front page itself: same origin only
		X-Frame-Options SAMEORIGIN
	}
	# the site's measures leave for PostHog (EU) by the site's own name, so
	# a blocker reads them as the site's; the visitor's cookies stay here
	handle_path /ingest/* {
		reverse_proxy https://eu.i.posthog.com {
			header_up Host eu.i.posthog.com
			header_up -Cookie
			header_up -Authorization
			header_down -Access-Control-Allow-Origin
		}
	}
	# the site itself, every unknown address answered by the page
	handle {
		root * /srv/blackrail/site
		try_files {path} /index.html
		# the built files carry their hash: kept a year; the pictures a week; the page never
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		@pictures path *.webp *.jpg *.png *.svg
		header @pictures Cache-Control "public, max-age=604800"
		header /index.html Cache-Control "no-cache"
		file_server
	}
}

www.playblackrail.com {
	redir https://playblackrail.com{uri} permanent
}

office.playblackrail.com {
	reverse_proxy 127.0.0.1:8787
}
